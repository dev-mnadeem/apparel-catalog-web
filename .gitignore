# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large image files (excluded for Heroku deployment)
public/images/products/
public/images/products-compressed/

# Cloudinary images - these are served from Cloudinary, not git
public/images/products-*/
!public/images/banners/
!public/images/categories/
!public/images/icon.png
project_venv/
venv/
.venv/
env/
node_modules/
__pycache__/
*.py[cod]
.next/
dist/
build/
*.log
.env
.env.local
coverage/

!.env.example
