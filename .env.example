# Browsing and cart operations need no provider credentials.
NEXT_PUBLIC_SHOW_SIMULATED_ACTIVITY=false

# Product photos. Leave empty to show the bundled demo swatches; set it to the
# store's Cloudinary cloud to serve the mapped photos. Read at build time.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Only for scripts/upload-images.js (reads .env.local). Never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Trusted server-to-server notification integration only.
NOTIFICATION_SERVICE_TOKEN=
EMAIL_API_KEY=
EMAIL_SERVICE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
